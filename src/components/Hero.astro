---
import { siteConfig } from "../config";
---

<!-- Top Olive Bar with Shimmer -->
<div class="w-full h-3 olive-bar-shimmer"></div>

<section
  id="hero"
  class="relative py-12 md:py-16 lg:py-20"
  style={`background-color: ${siteConfig.colors.creamLight}`}
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Main Hero Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Photo - Large Square -->
      <div class="order-2 md:order-1 flex justify-center md:justify-start">
        <div class="relative hero-photo">
          <div
            class="absolute -inset-3 rounded-2xl opacity-20"
            style={`background-color: ${siteConfig.colors.olive}`}
          ></div>
          <img
            src={`/profile.jpg`}
            alt={siteConfig.name}
            class="relative w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 object-cover rounded-2xl shadow-xl"
            style={`border: 4px solid ${siteConfig.colors.coral}`}
          />
        </div>
      </div>

      <!-- Text Content -->
      <div class="order-1 md:order-2 text-center md:text-left">
        <!-- Logo Mark -->
        <img
          src={`/logo-annie.jpg`}
          alt="Annie Sandoval Logo"
          class="hero-photo w-16 h-16 md:w-20 md:h-20 rounded-full mb-4 mx-auto md:mx-0"
        />
        <h1
          class="hero-title text-3xl md:text-4xl lg:text-5xl font-normal tracking-widest uppercase"
          style={`color: ${siteConfig.accentColor}; font-family: 'Raleway', sans-serif;`}
        >
          {siteConfig.name}
        </h1>
        <p
          class="hero-subtitle text-xl md:text-2xl font-light mt-2 mb-3"
          style={`color: ${siteConfig.colors.olive}; font-family: 'Raleway', sans-serif;`}
        >
          Psicóloga y Coach Ejecutiva
        </p>
        <div
          class="w-20 h-1 mb-4 mx-auto md:mx-0 rounded-full"
          style={`background-color: ${siteConfig.colors.coral}`}
        ></div>
        <p class="hero-description text-base md:text-lg text-gray-600 leading-relaxed mb-6 max-w-md mx-auto md:mx-0">
          Ayudo a nuevos líderes a encontrar su voz auténtica y transformar equipos con propósito.
        </p>

        <!-- CTA Button -->
        <a
          href={`mailto:${siteConfig.social?.email}?subject=Consulta sobre sesiones de coaching`}
          class="hero-cta btn-hover inline-flex items-center gap-2 px-6 py-3 rounded-full text-white font-medium mb-6"
          style={`background-color: ${siteConfig.colors.coral}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Escríbeme
        </a>

        <!-- Social Links -->
        <div class="hero-social flex gap-4 justify-center md:justify-start">
          {siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="icon-hover w-10 h-10 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="Email"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>
          )}
          {siteConfig.social?.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-hover w-10 h-10 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {siteConfig.social?.instagram && (
            <a
              href={siteConfig.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-hover w-10 h-10 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {siteConfig.social?.youtube && (
            <a
              href={siteConfig.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-hover w-10 h-10 rounded-full flex items-center justify-center"
              style={`background-color: ${siteConfig.accentColor}; color: white`}
              aria-label="YouTube"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="hero-stats grid grid-cols-3 gap-4 md:gap-8 mt-12 pt-8 border-t" style={`border-color: ${siteConfig.colors.olive}30`}>
      <div class="text-center stat-number">
        <div
          class="text-3xl md:text-4xl font-bold"
          style={`color: ${siteConfig.colors.coral}`}
        >10+</div>
        <div class="text-sm md:text-base text-gray-600">Años de experiencia</div>
      </div>
      <div class="text-center stat-number">
        <div
          class="text-3xl md:text-4xl font-bold"
          style={`color: ${siteConfig.colors.coral}`}
        >500+</div>
        <div class="text-sm md:text-base text-gray-600">Líderes formados</div>
      </div>
      <div class="text-center stat-number">
        <div
          class="text-3xl md:text-4xl font-bold"
          style={`color: ${siteConfig.colors.coral}`}
        >EEC</div>
        <div class="text-sm md:text-base text-gray-600">Coach Certificada</div>
      </div>
    </div>
  </div>
</section>

<!-- Bottom Olive Bar with Shimmer -->
<div class="w-full h-3 olive-bar-shimmer"></div>
